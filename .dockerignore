.git/
.gitignore
.venv/
.cache/
.aws-sam/
.kilo/
cdk.out/
.pytest_cache/
.ruff_cache/
# raw source data: only needed by scripts/precompute_data.py, never in images
data/
# frontend builds via Amplify, not docker
src/frontend/
# baked data is COPYed from src/economics/data (tracked there via build),
# but raw sources and caches never belong in an image context
# python artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
# secrets and local config
**/.env
**/.env.*
# docs
docs/